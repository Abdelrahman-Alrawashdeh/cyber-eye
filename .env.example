# Copy this file to `.env` and fill in the values. Never commit `.env`.

# ── Power scripts (poweron.ps1 / poweroff.ps1) ──────────
PROJECT_PATH="C:\cyber-eye"
DOCKER_DESKTOP_PATH="C:\Program Files\Docker\Docker\Docker Desktop.exe"
OPEN_URL="http://localhost:5173/login/"
INITIAL_DOCKER_WAIT=5
MAX_DOCKER_TRIES=30
DOCKER_RETRY_SECONDS=5
DOCKER_COMPOSE_CMD="docker compose up -d"
DOCKER_COMPOSE_DOWN_CMD="docker compose down"

# ── Flask API ───────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS="http://localhost:5173"

# ── Grafana admin ───────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# ── SMTP (Grafana alerting / Alertmanager) ──────────────
SMTP_SMARTHOST="smtp.gmail.com:587"
SMTP_FROM="alerts@example.com"
SMTP_USER="alerts@example.com"
SMTP_PASS="your-smtp-app-password"
ALERT_TO="soc-team@example.com"

# ── MySQL ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=cyber_eye

# ── Backend database connection ─────────────────────────
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=cyber_eye
DB_PORT=3306
DB_CHARSET=utf8mb4

# ── Fallback admin account (development only) ───────────
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_ADMIN_EMAIL=admin@cybereye.local
